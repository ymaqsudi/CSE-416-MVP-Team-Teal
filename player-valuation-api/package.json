{
  "name": "player-valuation-api",
  "version": "1.0.0",
  "description": "Player Valuation API for Fantasy Baseball Draft Kit - CSE 416 Team Teal",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "seed": "tsx src/scripts/seed.ts",
